---
layout: default
---
<div class="personal-home">
  <section class="profile-hero" aria-labelledby="profile-title">
    <div class="profile-intro">
      <p class="eyebrow">Universitas Brawijaya · Computer Science</p>
      <h1 id="profile-title">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero-subtitle">{{ page.subtitle }}</p>
      <div class="bio">{{ content }}</div>
      <div class="profile-actions">
        <a class="personal-button" href="{{ '/projects/' | relative_url }}">Explore my interests <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#contact">Get in touch <span aria-hidden="true">→</span></a>
      </div>
    </div>
    {% if page.profile.image %}
      <aside class="portrait-card" aria-label="Profile photo and location">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path sizes="(min-width: 768px) 280px, 70vw" alt=page.profile.alt %}
        <p>{{ page.profile.location }}</p>
      </aside>
    {% endif %}
  </section>
  <section class="interest-section" aria-labelledby="interests-title">
    <p class="eyebrow">What I’m exploring</p>
    <h2 id="interests-title">Research interests</h2>
    <ul class="interest-tags">
      {% for interest in page.interests %}<li>{{ interest }}</li>{% endfor %}
    </ul>
  </section>
  <section class="mentorship-panel" aria-labelledby="mentorship-title">
    <div>
      <p class="eyebrow">Learning together</p>
      <h2 id="mentorship-title">A little guidance can go a long way.</h2>
      <p>I dedicate one hour each week to guidance and mentorship for students from underrepresented groups, or anyone who needs support.</p>
    </div>
    <a class="personal-button" href="https://forms.gle/SVXkp8QxZTtp4B9s8">Request mentorship <span aria-hidden="true">↗</span></a>
  </section>
  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <p class="eyebrow">Let’s connect</p>
    <h2 id="contact-title">Open to a conversation.</h2>
    <p>{{ site.contact_note }}</p>
    <div class="contact-links">
      <a href="mailto:{{ site.data.socials.email }}">Email <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>
